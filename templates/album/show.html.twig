{% extends "base.html.twig" %}

{% block title %}Album:
	{{ album.title }}
{% endblock %}

{% block body %}
	<div class="row justify-content-center">
		<div class="col-md-6 col-lg-4">
			<h1>{{ album.title }}</h1>
			<p>Artist:
				{{ album.artist.name }}</p>

			<h2>Track List</h2>
			<ul>
				{# 1. Loop over trackList #}
				{% for track in album.trackList %}
					<li>{{ track }}</li>
				{% endfor %}
			</ul>

			<h2>Reviews</h2>
			<a href="{{ path('new_review', {'id': album.id}) }}" class="btn btn-info text-white me-3 mb-3">Add review</a>

			{% if reviews is empty %}
				<p>There are no reviews it seems...</p>
			{% else %}
				<div data-controller="load-more"
					 data-load-more-url-value="{{ path('show_album', {'id': album.id}) }}?reviewPartial=1">

					<div class="list-group" data-load-more-target="container">
						{% include 'partials/_review_items.html.twig' %}
					</div>

					{% if hasMore %}
						<div class="text-center mt-3" data-load-more-target="buttonWrapper">
							<button class="btn btn-outline-primary"
									data-load-more-target="button"
									data-next-offset="{{ nextOffset }}">
								Load More Reviews
							</button>
						</div>
					{% endif %}

				</div>
			{% endif %}

		</div>
	</div>
{% endblock %}
