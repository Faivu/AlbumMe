{% extends 'base.html.twig' %}

{% block title %}All Albums
{% endblock %}

{% block body %}
	<div class="container mt-4">

        <h1 class="mb-4 text-left">
            Check out all the albums
            {% if is_granted('ROLE_USER') %}
                <small class="mb-4 text-left">
                    , Or <a href="{{ path('new_album') }}" class="mb-4 text-left">create</a>
                     one yourself!
                </small>
            {% endif %}
        </h1>

		<div data-controller="load-more"
			 data-load-more-url-value="/?partial=1">

			<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4"
				 data-load-more-target="container">
				{% include 'partials/_album_cards.html.twig' %}
			</div>

			{% if albums is empty %}
				<div class="alert alert-warning text-center mt-3">
					No albums found.
					<a href="{{ path('new_album') }}">Add the first one!</a>
				</div>
			{% endif %}

			{% if hasMore %}
				<div class="text-center mt-4" data-load-more-target="buttonWrapper">
					<button class="btn btn-outline-primary"
							data-load-more-target="button"
							data-next-offset="{{ nextOffset }}">
						Load More
					</button>
				</div>
			{% endif %}

		</div>
	</div>
{% endblock %}
